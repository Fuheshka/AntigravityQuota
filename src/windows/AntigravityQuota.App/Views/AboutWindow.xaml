<ui:FluentWindow
    x:Class="AntigravityQuota.App.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AntigravityQuota.Core.ViewModels;assembly=AntigravityQuota.Core"
    mc:Ignorable="d"
    Title="AntigravityQuota • О программе"
    Width="520"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    Topmost="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True"
    Background="#1E1E1E"
    Foreground="#F3F3F3"
    d:DataContext="{d:DesignInstance vm:AboutViewModel}">

    <Border
        Margin="0"
        Padding="20"
        Background="#18181B"
        BorderBrush="#2E2E33"
        BorderThickness="1"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- TitleBar / Header -->
                <RowDefinition Height="Auto" /> <!-- Connection Status Card -->
                <RowDefinition Height="Auto" /> <!-- Hotkeys & Tips Card -->
                <RowDefinition Height="Auto" /> <!-- Actions (Copy Diagnostic) -->
                <RowDefinition Height="Auto" /> <!-- Footer & Authorship -->
            </Grid.RowDefinitions>

            <!-- 1. Custom TitleBar / Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Icon & Titles -->
                <Image
                    Grid.Column="0"
                    Source="pack://application:,,,/Assets/app-icon.png"
                    Width="40"
                    Height="40"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock
                            Text="AntigravityQuota"
                            FontWeight="Bold"
                            FontSize="16"
                            Foreground="#FFFFFF"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0" />

                        <!-- Version Badge -->
                        <Border
                            CornerRadius="6"
                            Background="#27272A"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            Padding="6,2,6,2"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding AppVersion, StringFormat='v{0}'}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#E4E4E7" />
                        </Border>

                        <!-- Platform Badge -->
                        <Border
                            CornerRadius="6"
                            Background="#0C4A6E"
                            BorderBrush="#0284C7"
                            BorderThickness="1"
                            Padding="6,2,6,2"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding PlatformInfo}"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#38BDF8" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Text="{Binding Loc.AboutDescription}"
                        FontSize="11"
                        Foreground="#A1A1AA"
                        Margin="0,3,0,0"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Close Button -->
                <ui:Button
                    Grid.Column="2"
                    Click="OnCloseButtonClick"
                    Padding="6"
                    VerticalAlignment="Top"
                    ToolTip="Закрыть"
                    Appearance="Transparent">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="#A1A1AA" />
                </ui:Button>
            </Grid>

            <!-- 2. Connection Status & Live Diagnostics Card -->
            <Border
                Grid.Row="1"
                Background="#202024"
                BorderBrush="#2E2E33"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12,14,12"
                Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Card Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Server24" FontSize="16" Foreground="#60A5FA" Margin="0,0,8,0" />
                            <TextBlock
                                Text="{Binding Loc.AboutConnectionStatus}"
                                FontWeight="SemiBold"
                                FontSize="12"
                                Foreground="#F3F3F3"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Connection Badge -->
                        <Border
                            Grid.Column="1"
                            CornerRadius="10"
                            Padding="8,3,8,3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#27272A" />
                                    <Setter Property="BorderBrush" Value="#3F3F46" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Background" Value="#14532D" />
                                            <Setter Property="BorderBrush" Value="#22C55E" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Margin="0,0,5,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#71717A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="#4ADE80" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock
                                    Text="{Binding ConnectionStatusText}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FFFFFF"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Diagnostic Metrics Table -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- PID -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Background="#18181B"
                            BorderBrush="#2E2E33"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6,8,6"
                            Margin="0,0,4,4">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc.AboutServerPid}" FontSize="10" Foreground="#71717A" />
                                <TextBlock
                                    Text="{Binding ServerPidText}"
                                    FontFamily="Consolas, Cascadia Code, Courier New"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#E4E4E7"
                                    Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Ports -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Background="#18181B"
                            BorderBrush="#2E2E33"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6,8,6"
                            Margin="4,0,0,4">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc.AboutServerPorts}" FontSize="10" Foreground="#71717A" />
                                <TextBlock
                                    Text="{Binding ServerPortsText}"
                                    FontFamily="Consolas, Cascadia Code, Courier New"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#38BDF8"
                                    Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- CSRF Token -->
                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Background="#18181B"
                            BorderBrush="#2E2E33"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6,8,6"
                            Margin="0,4,4,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc.AboutCsrfToken}" FontSize="10" Foreground="#71717A" />
                                <TextBlock
                                    Text="{Binding MaskedCsrfText}"
                                    FontFamily="Consolas, Cascadia Code, Courier New"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#FBBF24"
                                    Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Last Sync -->
                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Background="#18181B"
                            BorderBrush="#2E2E33"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6,8,6"
                            Margin="4,4,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc.AboutLastSync}" FontSize="10" Foreground="#71717A" />
                                <TextBlock
                                    Text="{Binding LastSyncText}"
                                    FontFamily="Consolas, Cascadia Code, Courier New"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#A1A1AA"
                                    Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. Hotkeys and Widget Control Card -->
            <Border
                Grid.Row="2"
                Background="#202024"
                BorderBrush="#2E2E33"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12,14,12"
                Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="Keyboard24" FontSize="16" Foreground="#A78BFA" Margin="0,0,8,0" />
                        <TextBlock
                            Text="{Binding Loc.AboutHotkeysTitle}"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Foreground="#F3F3F3"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="{Binding Loc.AboutHotkeyToggleHud}" FontSize="11" Foreground="#D4D4D8" Margin="0,2,0,2" />
                        <TextBlock Text="{Binding Loc.AboutHotkeyTogglePill}" FontSize="11" Foreground="#D4D4D8" Margin="0,2,0,2" />
                        <TextBlock Text="{Binding Loc.AboutHotkeyRefresh}" FontSize="11" Foreground="#D4D4D8" Margin="0,2,0,2" />
                        <TextBlock Text="{Binding Loc.AboutTipDrag}" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,2" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. Copy Diagnostic Action & Feedback -->
            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button
                        Grid.Column="0"
                        Command="{Binding CopyReportCommand}"
                        HorizontalAlignment="Stretch"
                        Padding="12,8,12,8"
                        Background="#27272A"
                        BorderBrush="#3F3F46"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="16" Margin="0,0,8,0" Foreground="#38BDF8" />
                            <TextBlock
                                Text="{Binding CopyReportButtonText}"
                                FontWeight="SemiBold"
                                FontSize="12"
                                Foreground="#FFFFFF"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button
                        Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        Padding="8"
                        Margin="8,0,0,0"
                        ToolTip="Обновить статус соединения"
                        Background="#27272A"
                        BorderBrush="#3F3F46"
                        BorderThickness="1">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Foreground="#A1A1AA" />
                    </ui:Button>
                </Grid>

                <!-- Feedback banner on copy -->
                <Border
                    Margin="0,6,0,0"
                    Padding="10,4,10,4"
                    CornerRadius="6"
                    Background="#14532D"
                    BorderBrush="#22C55E"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCopyFeedback}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="#4ADE80" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding CopyStatusFeedback}" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 5. Footer: Authorship & GitHub Links -->
            <Border
                Grid.Row="4"
                BorderBrush="#2E2E33"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Authorship Link -->
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                        <Hyperlink Command="{Binding OpenAuthorCommand}" Foreground="#38BDF8" TextDecorations="None">
                            <TextBlock Text="{Binding AuthorshipText}" FontSize="11" FontWeight="SemiBold" />
                        </Hyperlink>
                    </TextBlock>

                    <!-- GitHub & Releases Buttons -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button
                            Command="{Binding OpenGitHubCommand}"
                            Padding="8,4,8,4"
                            Margin="0,0,6,0"
                            Background="#27272A"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            ToolTip="Открыть исходный код на GitHub">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Code24" FontSize="14" Margin="0,0,5,0" Foreground="#E4E4E7" />
                                <TextBlock Text="GitHub" FontSize="11" Foreground="#E4E4E7" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            Command="{Binding OpenReleasesCommand}"
                            Padding="8,4,8,4"
                            Background="#27272A"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            ToolTip="Проверить релизы и обновления">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,5,0" Foreground="#38BDF8" />
                                <TextBlock Text="{Binding Loc.AboutReleases}" FontSize="11" Foreground="#E4E4E7" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>

                    <!-- Copyright Notice -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Text="Copyright © 2026 Daniil K. (Fuheshka). All rights reserved."
                        FontSize="10"
                        Foreground="#52525B"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
