<ui:FluentWindow
    x:Class="AntigravityQuota.App.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AntigravityQuota.Core.ViewModels;assembly=AntigravityQuota.Core"
    mc:Ignorable="d"
    Title="AntigravityQuota"
    Width="380"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True"
    Background="#1E1E1E"
    Foreground="#F3F3F3"
    d:DataContext="{d:DesignInstance vm:FlyoutViewModel}">

    <Border
        Margin="0"
        Padding="16,14,16,14"
        Background="#18181B"
        BorderBrush="#2E2E33"
        BorderThickness="1"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Gemini Card -->
                <RowDefinition Height="Auto" /> <!-- Claude Card -->
                <RowDefinition Height="Auto" /> <!-- Sparkline Card -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Icon & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app-icon.png" Width="20" Height="20" Margin="0,0,8,0" />
                    <TextBlock Text="AntigravityQuota" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="#FFFFFF" />
                </StackPanel>

                <!-- Online / Offline Status Badge -->
                <Border
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Padding="8,3,8,3"
                    CornerRadius="10"
                    Background="#27272A"
                    BorderBrush="#3F3F46"
                    BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse
                            Width="7"
                            Height="7"
                            Margin="0,0,5,0"
                            Fill="{Binding IsOnline, Converter={x:Null}}" />
                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" Foreground="#D4D4D8" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Force Refresh Button with Rotating Icon -->
                <ui:Button
                    Grid.Column="2"
                    Command="{Binding RefreshCommand}"
                    Padding="6"
                    ToolTip="{Binding Loc.MenuRefreshNow}"
                    VerticalAlignment="Center">
                    <ui:SymbolIcon
                        Symbol="ArrowSync24"
                        FontSize="15"
                        RenderTransformOrigin="0.5,0.5">
                        <ui:SymbolIcon.RenderTransform>
                            <RotateTransform x:Name="RefreshRotate" Angle="0" />
                        </ui:SymbolIcon.RenderTransform>
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinStory">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0"
                                                        To="360"
                                                        Duration="0:0:0.8" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinStory" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </ui:Button>
            </Grid>

            <!-- 2. Gemini Card -->
            <ui:Card Grid.Row="1" Margin="0,0,0,10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title & Percentage Badge -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Bot24" Foreground="#60A5FA" Margin="0,0,6,0" FontSize="16" />
                            <TextBlock Text="{Binding Loc.GeminiPoolTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5" />
                        </StackPanel>
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            FontSize="13"
                            Foreground="#60A5FA"
                            Text="{Binding GeminiFiveHourPct, StringFormat='{}{0:F1}%'}" />
                    </Grid>

                    <!-- Progress Bar -->
                    <ProgressBar
                        Grid.Row="1"
                        Height="6"
                        Value="{Binding GeminiFiveHourPct, Mode=OneWay}"
                        Maximum="100"
                        Foreground="#3B82F6"
                        Background="#27272A"
                        BorderThickness="0"
                        Margin="0,0,0,8" />

                    <!-- Timers: 5h and Weekly -->
                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 5h limit -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Timer20" FontSize="13" Foreground="#A1A1AA" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Loc.FiveHourLimit}" FontSize="11" Foreground="#A1A1AA" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding GeminiCountdownText}" FontSize="11" FontWeight="Medium" Foreground="#E4E4E7" />
                        </StackPanel>

                        <!-- Weekly limit -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CalendarLtr20" FontSize="13" Foreground="#A1A1AA" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Loc.WeeklyLimit}" FontSize="11" Foreground="#A1A1AA" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding GeminiWeeklyCountdownText}" FontSize="11" FontWeight="Medium" Foreground="#E4E4E7" />
                        </StackPanel>
                    </Grid>

                    <!-- Burn Rate Row -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowTrendingLines20" FontSize="13" Foreground="#93C5FD" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding GeminiBurnRateText}" FontSize="11" Foreground="#93C5FD" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- 3. Claude Card -->
            <ui:Card Grid.Row="2" Margin="0,0,0,10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title & Percentage Badge -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="BrainCircuit24" Foreground="#FB923C" Margin="0,0,6,0" FontSize="16" />
                            <TextBlock Text="{Binding Loc.ClaudePoolTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5" />
                        </StackPanel>
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            FontSize="13"
                            Foreground="#FB923C"
                            Text="{Binding ClaudeFiveHourPct, StringFormat='{}{0:F1}%'}" />
                    </Grid>

                    <!-- Progress Bar -->
                    <ProgressBar
                        Grid.Row="1"
                        Height="6"
                        Value="{Binding ClaudeFiveHourPct, Mode=OneWay}"
                        Maximum="100"
                        Foreground="#F97316"
                        Background="#27272A"
                        BorderThickness="0"
                        Margin="0,0,0,8" />

                    <!-- Timers: 5h and Weekly -->
                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 5h limit -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Timer20" FontSize="13" Foreground="#A1A1AA" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Loc.FiveHourLimit}" FontSize="11" Foreground="#A1A1AA" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding ClaudeCountdownText}" FontSize="11" FontWeight="Medium" Foreground="#E4E4E7" />
                        </StackPanel>

                        <!-- Weekly limit -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CalendarLtr20" FontSize="13" Foreground="#A1A1AA" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Loc.WeeklyLimit}" FontSize="11" Foreground="#A1A1AA" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding ClaudeWeeklyCountdownText}" FontSize="11" FontWeight="Medium" Foreground="#E4E4E7" />
                        </StackPanel>
                    </Grid>

                    <!-- Burn Rate Row -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowTrendingLines20" FontSize="13" Foreground="#FDBA74" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding ClaudeBurnRateText}" FontSize="11" Foreground="#FDBA74" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- 4. Sparkline Mini-Chart Card -->
            <ui:Card Grid.Row="3" Margin="0,0,0,10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="54" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DataArea24" FontSize="14" Foreground="#A1A1AA" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding Loc.SparklineTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7" />
                        </StackPanel>
                        <!-- Legend -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Rectangle Width="8" Height="3" Fill="#3B82F6" Margin="0,0,3,0" RadiusX="1" RadiusY="1" />
                            <TextBlock Text="Gemini" FontSize="10" Foreground="#A1A1AA" Margin="0,0,8,0" />
                            <Rectangle Width="8" Height="3" Fill="#F97316" Margin="0,0,3,0" RadiusX="1" RadiusY="1" />
                            <TextBlock Text="Claude" FontSize="10" Foreground="#A1A1AA" />
                        </StackPanel>
                    </Grid>

                    <!-- Sparkline Viewport -->
                    <Border Grid.Row="1" Background="#111113" CornerRadius="6" Padding="6,4,6,4" ClipToBounds="True">
                        <Grid>
                            <!-- Empty / Collecting Placeholder -->
                            <TextBlock
                                Text="{Binding Loc.CollectingData}"
                                FontSize="11"
                                Foreground="#71717A"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSparklineData}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Gemini Curve -->
                            <Path
                                Data="{Binding GeminiSparklinePath}"
                                Stroke="#3B82F6"
                                StrokeThickness="2"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSparklineData}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <!-- Claude Curve -->
                            <Path
                                Data="{Binding ClaudeSparklinePath}"
                                Stroke="#F97316"
                                StrokeThickness="1.5"
                                StrokeDashArray="3,2"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSparklineData}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Border>
                </Grid>
            </ui:Card>

            <!-- 5. Footer -->
            <Grid Grid.Row="4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Loc.UpdatedAt}" FontSize="11" Foreground="#71717A" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding LastUpdatedText}" FontSize="11" Foreground="#A1A1AA" />
                </StackPanel>

                <TextBlock
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="v1.0.0"
                    FontSize="10"
                    Foreground="#52525B" />
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
