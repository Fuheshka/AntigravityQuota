<Window
    x:Class="AntigravityQuota.App.Views.QuotaHudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AntigravityQuota.Core.ViewModels;assembly=AntigravityQuota.Core"
    mc:Ignorable="d"
    Title="AntigravityQuota HUD"
    WindowStyle="None"
    AllowsTransparency="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual"
    Style="{x:Null}"
    Background="Transparent"
    Foreground="#F3F3F3"
    MouseLeftButtonDown="OnRootMouseLeftButtonDown"
    MouseMove="OnRootMouseMove"
    MouseLeftButtonUp="OnRootMouseLeftButtonUp"
    d:DataContext="{d:DesignInstance vm:HudViewModel}">

    <Grid
        x:Name="RootContainer"
        Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{Binding Loc.MenuCompactPillMode}" Command="{Binding TogglePillModeCommand}" />
                <MenuItem Header="{Binding Loc.MenuRefreshNow}" Command="{Binding RefreshCommand}" />
                <Separator />
                <MenuItem Header="{Binding Loc.MenuEnableHUD}" Click="OnHideHudClick" />
                <MenuItem Header="{Binding Loc.MenuExit}" Click="OnExitAppClick" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- 1. COMPACT PILL MODE (Capsule HUD: ~230x32 px) -->
        <Border
            x:Name="PillView"
            Height="32"
            CornerRadius="16"
            Background="#E618181B"
            BorderBrush="#29FFFFFF"
            BorderThickness="1"
            Padding="10,0,8,0"
            Cursor="SizeAll">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPillMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Gemini Dot -->
                <Ellipse
                    Grid.Column="0"
                    Width="7"
                    Height="7"
                    Fill="{Binding PillGeminiColor}"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center" />

                <!-- Gemini Text (e.g. G 85%↓ 1h 12m) -->
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding PillGeminiText}"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    FontFamily="Consolas, Cascadia Mono, monospace"
                    Foreground="#FFFFFF"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0" />

                <!-- Bullet Separator -->
                <TextBlock
                    Grid.Column="2"
                    Text="·"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#59FFFFFF"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0" />

                <!-- Claude Dot -->
                <Ellipse
                    Grid.Column="3"
                    Width="7"
                    Height="7"
                    Fill="{Binding PillClaudeColor}"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center" />

                <!-- Claude Text (e.g. C 100%) -->
                <TextBlock
                    Grid.Column="4"
                    Text="{Binding PillClaudeText}"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    FontFamily="Consolas, Cascadia Mono, monospace"
                    Foreground="#FFFFFF"
                    VerticalAlignment="Center" />

                <!-- Expand Button [⤢] -->
                <Button
                    Grid.Column="6"
                    Command="{Binding TogglePillModeCommand}"
                    Width="18"
                    Height="18"
                    Padding="0"
                    Margin="8,0,0,0"
                    Background="#29FFFFFF"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="{Binding Loc.MenuEnableHUD}"
                    VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="9">
                                <ui:SymbolIcon
                                    Symbol="ArrowMaximize16"
                                    FontSize="9.5"
                                    Foreground="#E6FFFFFF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#40FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- 2. EXPANDED CARD MODE (Monolithic 256 px Card) -->
        <Border
            x:Name="CardView"
            Width="256"
            CornerRadius="13"
            Background="#E61E1E20"
            BorderBrush="#29FFFFFF"
            BorderThickness="1"
            Padding="12,10,12,10"
            Cursor="SizeAll">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPillMode}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <!-- Header: Blue Circular Bolt Icon, Title, Minus Button -->
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Blue circle icon with lightning/wave matching macOS bolt.horizontal.circle.fill -->
                        <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse Width="14" Height="14" Fill="#509AF8" />
                            <Path
                                Data="M 3.2,7.2 L 6.8,4.5 L 6.8,6.5 L 10.8,6.5 L 7.2,9.5 L 7.2,7.5 Z"
                                Fill="#FFFFFF"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock
                            Text="Antigravity Quota"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="#EBFFFFFF"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Collapse to Pill Button [—] -->
                    <Button
                        Grid.Column="2"
                        Command="{Binding TogglePillModeCommand}"
                        Width="16"
                        Height="16"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="{Binding Loc.MenuCompactPillMode}"
                        VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <Rectangle
                                        Width="10"
                                        Height="2"
                                        RadiusX="1"
                                        RadiusY="1"
                                        Fill="#BFFFFFFF"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.7" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Offline Message when not online -->
                <StackPanel Margin="0,6,0,6">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock
                        Text="{Binding Loc.ServerOffline}"
                        FontSize="11"
                        Foreground="#A6FFFFFF"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Pools Container (Visible when Online) -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Gemini Pool Row -->
                    <StackPanel Margin="0,0,0,9">
                        <!-- Title, Percentage, Reset in Parentheses -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding HudGeminiTitle}"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="#E6FFFFFF"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding GeminiFiveHourPct, StringFormat='{}{0:F1}%'}"
                                FontSize="12"
                                FontWeight="Bold"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                Foreground="{Binding GeminiBarColor}"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0" />

                            <TextBlock
                                Grid.Column="3"
                                Text="{Binding GeminiResetCountdownParentheses}"
                                FontSize="10"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                Foreground="#9EFFFFFF"
                                VerticalAlignment="Center" />
                        </Grid>

                        <!-- Progress Bar (Height 5) -->
                        <ProgressBar
                            Height="5"
                            Value="{Binding GeminiFiveHourPct, Mode=OneWay}"
                            Maximum="100"
                            Foreground="{Binding GeminiBarColor}"
                            Margin="0,0,0,4">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Border
                                        x:Name="PART_Track"
                                        Background="#24FFFFFF"
                                        CornerRadius="2.5"
                                        ClipToBounds="True">
                                        <Border
                                            x:Name="PART_Indicator"
                                            Background="{TemplateBinding Foreground}"
                                            CornerRadius="2.5"
                                            HorizontalAlignment="Left" />
                                    </Border>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>

                        <!-- Burn Rate Line: Orange Arrow + Formatted Text -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGeminiBurnRate}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock
                                Text="{Binding GeminiTrendArrow}"
                                FontSize="9.5"
                                FontWeight="Bold"
                                Foreground="{Binding GeminiTrendColor}"
                                Margin="0,0,3,0"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{Binding GeminiBurnRateFormatted}"
                                FontSize="9.5"
                                FontWeight="Medium"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                Foreground="#B8FFFFFF"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Weekly Limit Line: "Недельный: 4.3%" and "↻ 2д 19ч" -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding GeminiWeeklyText}"
                                FontSize="9.5"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                Foreground="#85FFFFFF"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding GeminiWeeklyResetText}"
                                FontSize="9.5"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                Foreground="#7AFFFFFF"
                                VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <!-- Claude / GPT Pool Row -->
                    <StackPanel Margin="0,0,0,9">
                        <!-- Title, Percentage, Reset in Parentheses -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding HudClaudeTitle}"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="#E6FFFFFF"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding ClaudeFiveHourPct, StringFormat='{}{0:F1}%'}"
                                FontSize="12"
                                FontWeight="Bold"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                Foreground="{Binding ClaudeBarColor}"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0" />

                            <TextBlock
                                Grid.Column="3"
                                Text="{Binding ClaudeResetCountdownParentheses}"
                                FontSize="10"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                Foreground="#9EFFFFFF"
                                VerticalAlignment="Center" />
                        </Grid>

                        <!-- Progress Bar (Height 5) -->
                        <ProgressBar
                            Height="5"
                            Value="{Binding ClaudeFiveHourPct, Mode=OneWay}"
                            Maximum="100"
                            Foreground="{Binding ClaudeBarColor}"
                            Margin="0,0,0,4">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Border
                                        x:Name="PART_Track"
                                        Background="#24FFFFFF"
                                        CornerRadius="2.5"
                                        ClipToBounds="True">
                                        <Border
                                            x:Name="PART_Indicator"
                                            Background="{TemplateBinding Foreground}"
                                            CornerRadius="2.5"
                                            HorizontalAlignment="Left" />
                                    </Border>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>

                        <!-- Burn Rate Line: Orange Arrow + Formatted Text -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasClaudeBurnRate}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock
                                Text="{Binding ClaudeTrendArrow}"
                                FontSize="9.5"
                                FontWeight="Bold"
                                Foreground="{Binding ClaudeTrendColor}"
                                Margin="0,0,3,0"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{Binding ClaudeBurnRateFormatted}"
                                FontSize="9.5"
                                FontWeight="Medium"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                Foreground="#B8FFFFFF"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Weekly Limit Line: "Недельный: 26.9%" and "↻ 6д 1ч" -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding ClaudeWeeklyText}"
                                FontSize="9.5"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                Foreground="#85FFFFFF"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding ClaudeWeeklyResetText}"
                                FontSize="9.5"
                                FontFamily="Consolas, Cascadia Mono, monospace"
                                Foreground="#7AFFFFFF"
                                VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Sparkline Viewport (Expandable, default collapsed) -->
                <StackPanel Margin="0,2,0,4">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSparklineExpanded}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Separator Background="#1FFFFFFF" Height="1" Margin="0,2,0,6" />

                    <!-- Sparkline Legend -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="5" Height="5" Fill="#47A6FF" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Gemini" FontSize="9.5" FontWeight="Medium" Foreground="#B8FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center" />

                            <Ellipse Width="5" Height="5" Fill="#C77BFF" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Claude" FontSize="9.5" FontWeight="Medium" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            Text="~1ч"
                            FontSize="9"
                            FontFamily="Consolas, Cascadia Mono, monospace"
                            Foreground="#73FFFFFF"
                            VerticalAlignment="Center" />
                    </Grid>

                    <!-- Sparkline Chart Area -->
                    <Border
                        Height="38"
                        Background="#0AFFFFFF"
                        BorderBrush="#14FFFFFF"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="2"
                        ClipToBounds="True">
                        <Grid>
                            <!-- Collecting Data Placeholder -->
                            <TextBlock
                                Text="{Binding Loc.CollectingData}"
                                FontSize="9.5"
                                Foreground="#8CFFFFFF"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSparklineData}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Claude Curve -->
                            <Path
                                Data="{Binding ClaudeSparklinePath}"
                                Stroke="#C77BFF"
                                StrokeThickness="1.5"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                Stretch="Fill">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSparklineData}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <!-- Gemini Curve -->
                            <Path
                                Data="{Binding GeminiSparklinePath}"
                                Stroke="#47A6FF"
                                StrokeThickness="1.5"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                Stretch="Fill">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSparklineData}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Footer: "Обновлено в 17:03", Sparkline Toggle, Refresh Button -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Last Updated ("Обновлено в 17:03") -->
                    <TextBlock
                        Grid.Column="0"
                        Text="{Binding FooterUpdatedText}"
                        FontSize="9"
                        FontFamily="Consolas, Cascadia Mono, monospace"
                        Foreground="#73FFFFFF"
                        VerticalAlignment="Center" />

                    <!-- Sparkline Toggle Button -->
                    <Button
                        Grid.Column="1"
                        Command="{Binding ToggleSparklineCommand}"
                        Padding="5,3,5,3"
                        Margin="0,0,5,0"
                        Background="#14FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="График расхода"
                        VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="BtnBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path
                                            Data="M 0,6 L 3,3 L 6,5 L 10,1"
                                            Stroke="#CCFFFFFF"
                                            StrokeThickness="1.2"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            Margin="0,0,3,0"
                                            VerticalAlignment="Center" />
                                        <Path
                                            x:Name="ChevronPath"
                                            Data="M 0,0 L 2.5,2.5 L 5,0"
                                            Stroke="#CCFFFFFF"
                                            StrokeThickness="1.2"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSparklineExpanded}" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#2E73B8FF" />
                                        <Setter TargetName="ChevronPath" Property="Data" Value="M 0,2.5 L 2.5,0 L 5,2.5" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#29FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Refresh Button: "↻ Обновить" -->
                    <Button
                        Grid.Column="2"
                        Command="{Binding RefreshCommand}"
                        Padding="7,3,7,3"
                        Background="#14FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="{Binding Loc.MenuRefreshNow}"
                        VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="BtnBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center">
                                            <TextBlock
                                                x:Name="RefreshIcon"
                                                Text="↻"
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Foreground="#CCFFFFFF"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock
                                            Text="{Binding Loc.RefreshShort}"
                                            FontSize="9.5"
                                            FontWeight="Medium"
                                            Foreground="#CCFFFFFF"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#29FFFFFF" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                        <Setter TargetName="RefreshIcon" Property="Foreground" Value="#FACC15" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinStory">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="RefreshIcon"
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0"
                                                        To="360"
                                                        Duration="0:0:0.8" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinStory" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
