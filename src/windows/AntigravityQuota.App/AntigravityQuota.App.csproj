<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TargetName>AntigravityQuota</TargetName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>AntigravityQuota.App</RootNamespace>
    <AssemblyName>AntigravityQuota</AssemblyName>
    <Product>AntigravityQuota</Product>
    <Company>Daniil K. (Fuheshka)</Company>
    <Authors>Daniil K. (Fuheshka)</Authors>
    <Copyright>Copyright © 2026 Daniil K. (Fuheshka). All rights reserved.</Copyright>
    <Version>1.2.0</Version>

    <!-- Release Publishing Profile Defaults -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntigravityQuota.Core\AntigravityQuota.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-icon.ico" />
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

</Project>
